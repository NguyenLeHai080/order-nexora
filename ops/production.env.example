# Copy to backend/.env on the server and edit secrets before going live.

APP_NAME=Order Nexora API
APP_ENV=prod
DEBUG=false
API_PREFIX=/api

# Recommended for large production:
# DATABASE_URL=postgresql+psycopg://order_nexora:CHANGE_ME@127.0.0.1:5432/order_nexora
DATABASE_URL=sqlite:///./order_nexora.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE_SECONDS=1800
AUTO_CREATE_TABLES=true

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=["https://nexoratech.com.vn"]
TRUSTED_HOSTS=["nexoratech.com.vn","*.nexoratech.com.vn","localhost","127.0.0.1"]
