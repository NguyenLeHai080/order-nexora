# App
APP_NAME=Order Nexora API
APP_ENV=local            # local | staging | prod
DEBUG=true
API_PREFIX=/api

# Database — mặc định SQLite cho dev. Production đổi sang Postgres:
# DATABASE_URL=postgresql+psycopg://order_nexora:strong_password@127.0.0.1:5432/order_nexora
DATABASE_URL=sqlite:///./order_nexora.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
AUTO_CREATE_TABLES=true

# JWT — BẮT BUỘC đổi jwt_secret khi lên production
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — danh sách origin frontend, phân tách bằng dấu phẩy (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1","nexoratech.com.vn","*.nexoratech.com.vn"]
